---
// Ultra-realistic VS Code + Copilot Chat mockup
---

<div class="vscode" id="demo">
  <!-- Title bar -->
  <div class="vs-titlebar">
    <div class="vs-traffic"><i></i><i></i><i></i></div>
    <span class="vs-title-text">sales_app.pbw — PowerBuilder MCP</span>
  </div>

  <!-- Body -->
  <div class="vs-body">
    <!-- Activity bar -->
    <div class="vs-actbar">
      <div class="vs-icon" title="Explorer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h7l2 2h9v11H3V6z"/></svg>
      </div>
      <div class="vs-icon" title="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      </div>
      <div class="vs-icon on" title="Copilot">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L4 6v6c0 5 3.4 9.3 8 10 4.6-.7 8-5 8-10V6l-8-4z"/></svg>
      </div>
      <div class="vs-icon" title="Source Control">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="8" r="2.5"/><path d="M6 8.5v7M8 18h4c2 0 4-2 4-4v-3"/></svg>
      </div>
      <div class="vs-icon" title="Extensions">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3h6v3l3-3 3 3v3h3v6h-3l3 3-3 3-3-3H9v-3H6V9H3V3z"/></svg>
      </div>
    </div>

    <!-- Explorer sidebar -->
    <div class="vs-sidebar">
      <div class="vs-sidehdr">
        <span>Explorer</span>
        <span class="vs-dots">···</span>
      </div>
      <div class="vs-tree">
        <div class="vs-tree-folder"><span class="chevron">▾</span><span class="ico">📦</span> SALES_APP</div>
        <div class="vs-tree-item active indent1"><span class="ico">📐</span><span class="lbl">sales_app.sra</span></div>
        <div class="vs-tree-item indent1"><span class="ico">📄</span><span class="lbl">sales.pbl</span></div>
        <div class="vs-tree-item indent1"><span class="ico">📄</span><span class="lbl">shared.pbl</span></div>
        <div class="vs-tree-item indent1"><span class="ico">📄</span><span class="lbl">inventory.pbl</span></div>
        <div class="vs-tree-item indent1"><span class="ico">📄</span><span class="lbl">reports.pbl</span></div>
        <div class="vs-tree-folder" style="margin-top:4px"><span class="chevron">▾</span><span class="ico">📁</span> Exported</div>
        <div class="vs-tree-item indent2"><span class="ico">🪟</span><span class="lbl">w_order_entry.srw</span></div>
        <div class="vs-tree-item indent2"><span class="ico">📊</span><span class="lbl">d_order_summary.srd</span></div>
        <div class="vs-tree-item indent2"><span class="ico">📊</span><span class="lbl">d_customer_list.srd</span></div>
      </div>
    </div>

    <!-- Editor -->
    <div class="vs-editor">
      <div class="vs-tabs">
        <div class="vs-tab active"><span class="ficon">🪟</span> w_order_entry.srw</div>
        <div class="vs-tab"><span class="ficon">📊</span> d_order_summary.srd</div>
      </div>
      <div class="vs-code-area">
        <div class="vs-linenumbers">
          {Array.from({ length: 15 }, (_, i) => <div>{i + 1}</div>)}
        </div>
        <div class="vs-code-content"><span class="c-comment">$PBExportHeader$w_order_entry.srw</span>
<span class="c-key">forward</span>
<span class="c-key">global type</span> w_order_entry <span class="c-key">from</span> window
<span class="c-key">end type</span>
<span class="c-key">end forward</span>

<span class="c-key">global type</span> w_order_entry <span class="c-key">from</span> window
   <span class="c-var">int</span> width  = 1200
   <span class="c-var">int</span> height = 800
<span class="c-key">end type</span>

<span class="c-key">event</span> <span class="c-fn">open</span>;
   <span class="c-var">this</span>.<span class="c-fn">dw_1</span>.<span class="c-fn">InsertRow</span>(0)
   <span class="c-var">this</span>.<span class="c-fn">SetTitle</span>(<span class="c-str">"Order Entry — Customer #"</span> + &amp;
      <span class="c-fn">String</span>(<span class="c-var">il_customer_id</span>))
<span class="c-key">end event</span>

<span class="c-comment">// TODO: validate customer_id before retrieve</span></div>
      </div>
    </div>

    <!-- Copilot Chat -->
    <div class="vs-chat">
      <div class="vs-chat-hdr">
        <span class="cp-badge">✦</span>
        Copilot
        <span class="vs-chat-mode">Agent</span>
      </div>
      <div class="vs-msgs">
        <div class="msg-row">
          <div class="msg-av u">A</div>
          <div class="msg-body">
            <div class="msg-name u">You</div>
            <div class="msg-text">Find every DataWindow using <code>customer_id</code>, then summarize dependencies before I refactor.</div>
          </div>
        </div>
        <div class="msg-row">
          <div class="msg-av b">✦</div>
          <div class="msg-body">
            <div class="msg-name b">Copilot <span class="verified">✓</span></div>
            <div class="msg-text">I'll inspect the workspace and export the relevant objects.</div>
            <div class="tool-card">
              <div class="tool-card-hdr"><span class="check-icon">✓</span> list_libraries</div>
              <div class="tool-card-body"><span class="tool-dim">→</span> <span class="tool-result">sales.pbl, shared.pbl, inventory.pbl, reports.pbl</span></div>
            </div>
            <div class="tool-card">
              <div class="tool-card-hdr"><span class="check-icon">✓</span> search_objects</div>
              <div class="tool-card-body">pattern: <span class="tool-arg">"customer"</span>, type: <span class="tool-arg">"DataWindow"</span><br><span class="tool-dim">→</span> <span class="tool-result">d_customer_list, d_order_summary, d_invoice_detail</span></div>
            </div>
            <div class="tool-card">
              <div class="tool-card-hdr"><span class="check-icon">✓</span> export_object → parse_datawindow</div>
              <div class="tool-card-body">library: <span class="tool-arg">"sales.pbl"</span>, object: <span class="tool-arg">"d_order_summary"</span><br><span class="tool-dim">→</span> <span class="tool-result">table: orders, customers</span><br><span class="tool-dim">→</span> <span class="tool-result">retrieval args: order_id, customer_id</span></div>
            </div>
            <div class="tool-card">
              <div class="tool-card-hdr"><span class="check-icon">✓</span> analyze_dependencies</div>
              <div class="tool-card-body"><span class="tool-dim">→</span> <span class="tool-result">f_customer_lookup, uo_order_service</span></div>
            </div>
            <div class="msg-text" style="margin-top:8px">Found <strong>3 DataWindows</strong> referencing <code>customer_id</code>. Two share the same retrieval pattern; <code>d_order_summary</code> also depends on <code>f_customer_lookup</code>.</div>
            <div class="suggestion-card">📋 Refactor plan ready — standardize retrieval args across all 3 DataWindows and extract shared lookup into uo_customer_service.</div>
          </div>
        </div>
      </div>
      <div class="vs-chat-input">
        <div class="vs-input-row">
          <span class="placeholder">Ask Copilot about your PowerBuilder workspace…</span>
          <div class="vs-send-btn">↑</div>
        </div>
        <div class="vs-input-meta">
          <span>⚡ @powerbuilder</span>
          <span>📎 Context: w_order_entry.srw</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Status bar -->
  <div class="vs-statusbar">
    <div class="sb-item"><span class="sb-dot"></span> main</div>
    <div class="sb-item">Ln 14, Col 3</div>
    <div class="sb-item">Spaces: 3</div>
    <div class="sb-item">UTF-8</div>
    <div class="sb-spacer"></div>
    <div class="sb-item">PowerBuilder</div>
    <div class="sb-item mcp">✦ MCP: powerbuilder</div>
  </div>
</div>

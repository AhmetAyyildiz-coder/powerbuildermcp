---
const prompts = [
  {
    trTitle: 'Çalışma alanı keşfi', enTitle: 'Workspace discovery',
    trDesc: 'PowerBuilder uygulama yapınızın tam envanterini alın.',
    enDesc: 'Get a full inventory of your PowerBuilder application structure.',
    code: `List all libraries in this workspace, then show me a summary of object types in each library (windows, DataWindows, user objects, functions).`,
  },
  {
    trTitle: 'DataWindow denetimi', enTitle: 'DataWindow audit',
    trDesc: 'Karmaşık veya riskli SQL pattern\'lerine sahip DataWindow\'ları bulun.',
    enDesc: 'Find DataWindows with complex or risky SQL patterns.',
    code: `Search for all DataWindows that use "customer_id" as a retrieval argument. For each one, export the source and extract the SQL query, tables, and columns. Flag any that have nested DataWindows.`,
  },
  {
    trTitle: 'Bağımlılık izleme', enTitle: 'Dependency tracing',
    trDesc: 'Refactor öncesi neyin neye bağlı olduğunu haritalayın.',
    enDesc: 'Map what depends on what before refactoring.',
    code: `Export w_order_entry and analyze its dependencies. List every function, user object, and external reference it calls. Then check if any of those are also used by other windows.`,
  },
  {
    trTitle: 'Migrasyon planlama', enTitle: 'Migration planning',
    trDesc: 'Önce neyi modernize edeceğinize öncelik verin.',
    enDesc: 'Prioritize what to modernize first.',
    code: `Find all global functions and rank them by how many objects reference them. Identify the top 5 most coupled components that would be hardest to extract into a service layer.`,
  },
  {
    trTitle: 'Güvenli düzenleme planlama', enTitle: 'Safe edit planning',
    trDesc: 'Tam bağlamla kontrollü bir değişiklik planlayın.',
    enDesc: 'Plan a controlled change with full context.',
    code: `I need to add a "status" column to d_order_summary. Find every object that references this DataWindow, check what retrieval arguments it uses, and tell me what else needs to change.`,
  },
  {
    trTitle: 'Ölü kod tespiti', enTitle: 'Dead code detection',
    trDesc: 'Kimse referans vermediği nesneleri bulun.',
    enDesc: 'Find objects nobody references.',
    code: `List all user objects in shared.pbl. For each one, search the entire workspace to see if any other object references it. Report any that have zero references.`,
  },
  {
    trTitle: 'DataWindow ↔ Tablo şema doğrulama', enTitle: 'DataWindow ↔ table schema validation',
    trDesc: 'DataWindow SQL\'i ile gerçek veritabanı şemasını çapraz kontrol edin. (PowerBuilder MCP + SQL MCP birlikte)',
    enDesc: 'Cross-check DataWindow SQL against the actual database schema. (PowerBuilder MCP + SQL MCP together)',
    code: `Export d_order_entry and extract its SQL, tables, and columns. Then query the database schema for the orders table. Compare the two and tell me: which columns exist in the DataWindow but not in the table, and which columns exist in the table but aren't used by the DataWindow?`,
  },
  {
    trTitle: 'Dynamic SQL izleme', enTitle: 'Dynamic SQL tracing',
    trDesc: 'Runtime\'da kurulan SQL string\'lerini trace ederek hangi tablolara erişildiğini bulun.',
    enDesc: 'Trace SQL strings built at runtime to discover which tables are actually accessed.',
    code: `Export w_customer_search. It builds its query dynamically based on user filters. Read every line where ls_sql is assigned or concatenated. List every possible table and column that can end up in the final SQL, grouped by which filter condition triggers them. Flag any branches that reference tables which no longer exist in the database.`,
  },
  {
    trTitle: 'EXECUTE IMMEDIATE denetimi', enTitle: 'EXECUTE IMMEDIATE audit',
    trDesc: 'Tüm EXECUTE IMMEDIATE ve PREPARE/EXECUTE bloklarını bulun ve içeriğini çözün.',
    enDesc: 'Find all EXECUTE IMMEDIATE and PREPARE/EXECUTE blocks and resolve their contents.',
    code: `Search the entire workspace for EXECUTE IMMEDIATE and PREPARE statements. For each one, trace backwards to find where the SQL string was constructed. Report: object name, line range, the full reconstructed SQL if possible, and the target tables. Rank them by complexity — which ones have the most conditional branches.`,
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'PowerBuilder MCP — Prompt Library',
  description: 'Real-world prompt examples for using PowerBuilder MCP with GitHub Copilot.',
  author: { '@type': 'Organization', name: 'PowerBuilder MCP' },
  url: 'https://powerbuildermcp.com/prompts',
};

import Base from '../layouts/Base.astro';
---

<Base
  title="PowerBuilder MCP — Prompt Kütüphanesi"
  description="PowerBuilder MCP'yi GitHub Copilot ile kullanmak için gerçek dünya prompt örnekleri. DataWindow denetimi, bağımlılık izleme, migrasyon planlama ve daha fazlası."
  ogType="article"
  schema={schema}
>
  <main class="section">
    <div class="container">
      <div class="kicker" data-en="Prompt Library">Prompt Kütüphanesi</div>
      <h1 class="page-title" data-en="Copy-paste prompts<br>that actually work">
        Gerçekten çalışan<br>kopyala-yapıştır promptlar
      </h1>
      <p class="top" data-en="Tested prompt patterns for common PowerBuilder analysis and modernization tasks. Paste these into Copilot Chat with the PowerBuilder MCP server connected.">
        Yaygın PowerBuilder analiz ve modernizasyon görevleri için test edilmiş prompt pattern'leri. Bunları PowerBuilder MCP sunucusu bağlıyken Copilot Chat'e yapıştırın.
      </p>

      <div class="prompts">
        {prompts.map((p) => (
          <article class="prompt-card">
            <h3 data-en={p.enTitle}>{p.trTitle}</h3>
            <p data-en={p.enDesc}>{p.trDesc}</p>
            <pre>{p.code}</pre>
          </article>
        ))}
      </div>
    </div>
  </main>
</Base>
